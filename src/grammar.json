{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "lisp",
  "rules": {
    "program": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_expression"
      }
    },
    "_expression": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_intertoken"
        },
        {
          "type": "SYMBOL",
          "name": "_s_expr"
        }
      ]
    },
    "_intertoken": {
      "type": "CHOICE",
      "members": [
        {
          "type": "TOKEN",
          "content": {
            "type": "REPEAT1",
            "content": {
              "type": "PATTERN",
              "value": "[ \\r\\n\\t\\f\\v\\p{Zs}\\p{Zl}\\p{Zp}]"
            }
          }
        },
        {
          "type": "SYMBOL",
          "name": "comment"
        }
      ]
    },
    "comment": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_line_comment"
        },
        {
          "type": "SYMBOL",
          "name": "_block_comment"
        }
      ]
    },
    "_line_comment": {
      "type": "PATTERN",
      "value": ";.*"
    },
    "_block_comment": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "#|"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "PREC",
                "value": 100,
                "content": {
                  "type": "SYMBOL",
                  "name": "_block_comment"
                }
              },
              {
                "type": "PATTERN",
                "value": ".|[\\r\\n\\u{85}\\u{2028}\\u{2029}]"
              }
            ]
          }
        },
        {
          "type": "PREC",
          "value": 100,
          "content": {
            "type": "STRING",
            "value": "|#"
          }
        }
      ]
    },
    "_s_expr": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "token"
        },
        {
          "type": "SYMBOL",
          "name": "list"
        },
        {
          "type": "SYMBOL",
          "name": "reader_macro"
        },
        {
          "type": "SYMBOL",
          "name": "quote"
        },
        {
          "type": "SYMBOL",
          "name": "quasiquote"
        },
        {
          "type": "SYMBOL",
          "name": "unquote"
        },
        {
          "type": "SYMBOL",
          "name": "unquote_splicing"
        }
      ]
    },
    "_string": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "\""
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SEQ",
                  "members": [
                    {
                      "type": "STRING",
                      "value": "\\"
                    },
                    {
                      "type": "PATTERN",
                      "value": "."
                    }
                  ]
                },
                {
                  "type": "STRING",
                  "value": "\\\n"
                },
                {
                  "type": "PATTERN",
                  "value": "[^\"\\\\]+"
                }
              ]
            }
          },
          {
            "type": "STRING",
            "value": "\""
          }
        ]
      }
    },
    "_pure_token": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "REPEAT1",
            "content": {
              "type": "PATTERN",
              "value": "[^ \\r\\n\\t\\f\\v\\p{Zs}\\p{Zl}\\p{Zp}#;\"'`,\\(\\)\\[\\]\\{\\}|]"
            }
          },
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "|"
              },
              {
                "type": "REPEAT",
                "content": {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "STRING",
                      "value": "\\\n"
                    },
                    {
                      "type": "PATTERN",
                      "value": "[^|]+"
                    }
                  ]
                }
              },
              {
                "type": "STRING",
                "value": "|"
              }
            ]
          }
        ]
      }
    },
    "token": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_pure_token"
        },
        {
          "type": "SYMBOL",
          "name": "_string"
        }
      ]
    },
    "list": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "("
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "SYMBOL",
                "name": "_expression"
              }
            },
            {
              "type": "STRING",
              "value": ")"
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "["
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "SYMBOL",
                "name": "_expression"
              }
            },
            {
              "type": "STRING",
              "value": "]"
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "{"
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "SYMBOL",
                "name": "_expression"
              }
            },
            {
              "type": "STRING",
              "value": "}"
            }
          ]
        }
      ]
    },
    "reader_macro": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "#"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "STRING",
                  "value": "\\"
                },
                {
                  "type": "PATTERN",
                  "value": "[#;\"'`,\\(\\)\\[\\]\\{\\}]"
                }
              ]
            },
            {
              "type": "SYMBOL",
              "name": "list"
            },
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "STRING",
                  "value": "'"
                },
                {
                  "type": "REPEAT",
                  "content": {
                    "type": "SYMBOL",
                    "name": "_intertoken"
                  }
                },
                {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "SYMBOL",
                      "name": "_pure_token"
                    },
                    {
                      "type": "SYMBOL",
                      "name": "list"
                    }
                  ]
                }
              ]
            },
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "STRING",
                  "value": ";"
                },
                {
                  "type": "REPEAT",
                  "content": {
                    "type": "SYMBOL",
                    "name": "_intertoken"
                  }
                },
                {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "SYMBOL",
                      "name": "_pure_token"
                    },
                    {
                      "type": "SYMBOL",
                      "name": "list"
                    }
                  ]
                }
              ]
            },
            {
              "type": "PREC",
              "value": 100,
              "content": {
                "type": "SEQ",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "_pure_token"
                  },
                  {
                    "type": "CHOICE",
                    "members": [
                      {
                        "type": "SYMBOL",
                        "name": "_string"
                      },
                      {
                        "type": "SYMBOL",
                        "name": "list"
                      }
                    ]
                  }
                ]
              }
            },
            {
              "type": "PREC",
              "value": -100,
              "content": {
                "type": "SYMBOL",
                "name": "_pure_token"
              }
            }
          ]
        }
      ]
    },
    "quote": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "'"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_intertoken"
          }
        },
        {
          "type": "SYMBOL",
          "name": "_s_expr"
        }
      ]
    },
    "quasiquote": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "`"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_intertoken"
          }
        },
        {
          "type": "SYMBOL",
          "name": "_s_expr"
        }
      ]
    },
    "unquote": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": ","
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_intertoken"
          }
        },
        {
          "type": "SYMBOL",
          "name": "_s_expr"
        }
      ]
    },
    "unquote_splicing": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": ",@"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_intertoken"
          }
        },
        {
          "type": "SYMBOL",
          "name": "_s_expr"
        }
      ]
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}