{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "commonlisp",
      "camelcase": "CommonLisp",
      "title": "Common Lisp",
      "scope": "source.commonlisp",
      "file-types": [
        "commonlisp"
      ],
      "injection-regex": "^commonlisp$",
      "class-name": "TreeSitterCommonlisp"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Commonlisp grammar for tree-sitter",
    "authors": [
      {
        "name": "Yiran Lu",
        "email": "me@yiranls.cc",
        "url": "https://yiranls.cc/"
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-commonlisp",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}