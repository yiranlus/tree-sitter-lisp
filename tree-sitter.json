{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "lisp",
      "camelcase": "Lisp",
      "title": "Lisp",
      "scope": "source.lisp",
      "file-types": [
        "lisp,scheme"
      ],
      "injection-regex": "^lisp$",
      "class-name": "TreeSitterLisp"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "A universal Lisp Treesitter",
    "authors": [
      {
        "name": "Yiran Lu",
        "email": "me@yiranls.cc",
        "url": "https://yiranls.cc/"
      }
    ],
    "links": {
      "repository": "https://github.com/yiranlus/tree-sitter-lisp",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}